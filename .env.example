# Copy this file to .env.local and fill in only what you use.

# --- Local app ---
# Leave blank for `npm run dev`. Set to local-production before `npm run build` / `npm run start`.
# Allowed: local-development, local-production, test.
BLOGR_MODE=
# Folder for your workspaces, articles, and images. Blank uses ~/.blogr.
BLOGR_HOME=

# --- AI writing, images, and keyword ideas (Replicate) ---
REPLICATE_API_TOKEN=
# Optional model overrides. These are the defaults.
REPLICATE_WRITER_MODEL=anthropic/claude-sonnet-4.6
REPLICATE_IMAGE_PLANNER_MODEL=openai/gpt-5-mini
REPLICATE_IMAGE_MODEL=google/nano-banana-2

# --- Research ---
# Site scans, link refresh, article research, and a last-resort YouTube search.
FIRECRAWL_API_KEY=
# Google search research for topic ideas, AI fill, and topic briefs.
APIFY_TOKEN=
# YouTube videos in articles. YouTube is tried first, then Exa.
YOUTUBE_API_KEY=
EXA_API_KEY=

# --- Publishing to your blog (optional) ---
# Shared secret your blog's webhook checks. Never saved in workspaces or backups.
BLOG_PUBLISH_WEBHOOK_TOKEN=
# Optional per-workspace tokens as JSON, overriding the token above:
# BLOG_PUBLISH_WEBHOOK_TOKENS={"<workspace-id>":"<token>"}
BLOG_PUBLISH_WEBHOOK_TOKENS=
# Default webhook URL; each workspace can set its own in Settings → Publishing.
BLOG_PUBLISH_WEBHOOK_URL=
# Sent as the article's `source` (not the author). Defaults to Blogr.
BLOG_PUBLISH_SOURCE_NAME=Blogr
# How long to wait for your blog to respond, in ms (default 15000, max 60000).
BLOG_PUBLISH_TIMEOUT_MS=15000
